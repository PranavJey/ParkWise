# ==============================================================================
# ParkWise AI — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# Application
VITE_APP_TITLE="ParkWise AI"
VITE_APP_DESCRIPTION="AI-Powered Parking Discovery PWA"
VITE_APP_VERSION="0.6.0-phase6"

# ── AI — Phase 6: Secure Server-Side Architecture ─────────────────────────────
#
# ParkWise uses Groq hosted inference to run Meta Llama 3.1 8B Instant.
# Llama 3.1 is an open-weight model by Meta AI (Meta Llama 3.1 Community License).
# Groq provides free-tier API access; sign up at https://console.groq.com
#
# SECURITY:
# GROQ_API_KEY is a SERVER-SIDE environment variable only.
# It is used by the /api/ai proxy endpoint (or Vercel / serverless functions).
# It is NEVER exposed to or bundled into browser JavaScript (no VITE_ prefix).
#
# Without this key the AI recommendation automatically falls back to the
# local deterministic parser and templates (no external calls, always works).
#
GROQ_API_KEY=

# ── OpenStreetMap (no key required) ───────────────────────────────────────────
# Parking location data is retrieved from OpenStreetMap via the public
# Overpass API — no API key needed.
# On failure the app falls back to DemoParkingProvider automatically.
